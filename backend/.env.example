# Скопируйте этот файл в .env и заполните. Файл .env не попадает в git.

# Секрет: API-токен Travelpayouts (кабинет → Programs → Aviasales → API). Никому не показывайте.
TRAVELPAYOUTS_TOKEN=

# Идентификаторы партнёра (не секреты): Partner ID и номер проекта (trs) из партнёрской ссылки
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_TRS=

# Секрет запуска проверки цен по расписанию (придумайте длинную случайную строку)
CRON_SECRET=
